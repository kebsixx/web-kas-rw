# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google Spreadsheet ID (from the URL: https://docs.google.com/spreadsheets/d/{THIS_PART}/edit)
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Google Service Account JSON (paste the entire JSON content as a single line)
GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
